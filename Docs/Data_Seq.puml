@startuml
skinparam componentStyle uml2

package "Field Level" {
  node "Zigbee Sensor Node" {
    [Hardware WDT] -right-> [MCU]
    [Battery] -down-> [MCU]
    [Sensor] -down-> [MCU]
    [MCU] <--> [Zigbee Radio]
  }
}

node "Industrial Edge Gateway" {
  [Zigbee Coordinator] as ZBRx
  [Message Queue] as MQ
  [Payload Parser] as Parser
  [Stale Data Watchdog] as Timeout
  [Shared Memory] as RegMap
  [Modbus Server] as MBServer
  
  ZBRx -right-> MQ : Raw Packets
  MQ -right-> Parser : Process
  Parser -down-> RegMap : Update Register
  Timeout -up-> RegMap : Invalidate (0xFFFF)
  RegMap <-right- MBServer : Fetch Data
}

package "OT Network" {
  node "PLC / SCADA" {
    [Modbus Client] as MBClient
  }
}

[Zigbee Radio] <..> ZBRx : Zigbee Wireless\n(AES-128)
MBClient <--> MBServer : Ethernet/RS485
@enduml